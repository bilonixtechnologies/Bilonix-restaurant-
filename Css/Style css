*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:"Poppins",sans-serif;
}

body{
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    background:linear-gradient(135deg,#0f172a,#1e293b,#2563eb);
    background-size:300% 300%;
    animation:bgMove 10s ease infinite;
}

@keyframes bgMove{
    0%{background-position:0% 50%;}
    50%{background-position:100% 50%;}
    100%{background-position:0% 50%;}
}

.login-container{
    width:100%;
    display:flex;
    justify-content:center;
    align-items:center;
    padding:20px;
}

.login-card{
    width:380px;
    padding:40px 30px;
    background:rgba(255,255,255,0.08);
    backdrop-filter:blur(15px);
    border:1px solid rgba(255,255,255,0.15);
    border-radius:20px;
    box-shadow:0 20px 40px rgba(0,0,0,.35);
    text-align:center;
    color:#fff;
}

.login-card h1{
    font-size:2rem;
    color:#38bdf8;
    margin-bottom:5px;
}

.login-card p{
    color:#cbd5e1;
    margin-bottom:30px;
}

.input-box{
    display:flex;
    align-items:center;
    background:rgba(255,255,255,.1);
    border-radius:12px;
    padding:12px 15px;
    margin-bottom:18px;
}

.input-box i{
    color:#38bdf8;
    margin-right:10px;
}

.input-box input{
    width:100%;
    background:none;
    border:none;
    outline:none;
    color:#fff;
    font-size:1rem;
}

.input-box input::placeholder{
    color:#cbd5e1;
}

.options{
    display:flex;
    justify-content:space-between;
    align-items:center;
    font-size:.9rem;
    margin-bottom:20px;
}

.options a{
    color:#38bdf8;
    text-decoration:none;
}

button{
    width:100%;
    padding:14px;
    border:none;
    border-radius:12px;
    background:#2563eb;
    color:#fff;
    font-size:1rem;
    font-weight:600;
    cursor:pointer;
    transition:.3s;
}

button:hover{
    background:#1d4ed8;
    transform:translateY(-2px);
}

@media(max-width:480px){
    .login-card{
        width:100%;
        padding:30px 20px;
    }
}
