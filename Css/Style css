*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:"Poppins",sans-serif;
}

body{
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    background:linear-gradient(135deg,#0f172a,#1e293b,#2563eb);
    background-size:300% 300%;
    animation:bgMove 10s ease infinite;
}

@keyframes bgMove{
    0%{background-position:0% 50%;}
    50%{background-position:100% 50%;}
    100%{background-position:0% 50%;}
}

.login-container{
    width:100%;
    display:flex;
    justify-content:center;
    align-items:center;
    padding:20px;
}

.login-card{
    width:380px;
    padding:40px 30px;
    background:rgba(255,255,255,0.08);
    backdrop-filter:blur(15px);
    border:1px solid rgba(255,255,255,0.15);
    border-radius:20px;
    box-shadow:0 20px 40px rgba(0,0,0,.35);
    text-align:center;
    color:#fff;
}

.login-card h1{
    font-size:2rem;
    color:#38bdf8;
    margin-bottom:5px;
}

.login-card p{
    color:#cbd5e1;
    margin-bottom:30px;
}

.input-box{
    display:flex;
    align-items:center;
    background:rgba(255,255,255,.1);
    border-radius:12px;
    padding:12px 15px;
    margin-bottom:18px;
}

.input-box i{
    color:#38bdf8;
    margin-right:10px;
}

.input-box input{
    width:100%;
    background:none;
    border:none;
    outline:none;
    color:#fff;
    font-size:1rem;
}

.input-box input::placeholder{
    color:#cbd5e1;
}

.options{
    display:flex;
    justify-content:space-between;
    align-items:center;
    font-size:.9rem;
    margin-bottom:20px;
}

.options a{
    color:#38bdf8;
    text-decoration:none;
}

button{
    width:100%;
    padding:14px;
    border:none;
    border-radius:12px;
    background:#2563eb;
    color:#fff;
    font-size:1rem;
    font-weight:600;
    cursor:pointer;
    transition:.3s;
}

button:hover{
    background:#1d4ed8;
    transform:translateY(-2px);
}

@media(max-width:480px){
    .login-card{
        width:100%;
        padding:30px 20px;
    }
}
/* ==========================
   DASHBOARD
========================== */

.sidebar{
    position:fixed;
    top:0;
    left:0;
    width:250px;
    height:100vh;
    background:#111827;
    padding:30px 20px;
    color:#fff;
}

.sidebar h2{
    color:#38bdf8;
    text-align:center;
    margin-bottom:40px;
}

.sidebar ul{
    list-style:none;
}

.sidebar ul li{
    padding:15px;
    margin:10px 0;
    border-radius:10px;
    cursor:pointer;
    transition:.3s;
}

.sidebar ul li:hover{
    background:#2563eb;
}

.sidebar ul li i{
    margin-right:10px;
}

.main{
    margin-left:250px;
    width:calc(100% - 250px);
    min-height:100vh;
    padding:30px;
}

header h1{
    color:#fff;
    margin-bottom:30px;
}

.cards{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:20px;
}

.card{
    background:rgba(255,255,255,.08);
    backdrop-filter:blur(10px);
    border-radius:15px;
    padding:25px;
    color:#fff;
    transition:.3s;
}

.card:hover{
    transform:translateY(-8px);
    box-shadow:0 15px 30px rgba(0,0,0,.3);
}

.card h3{
    color:#cbd5e1;
    margin-bottom:10px;
}

.card h2{
    font-size:2rem;
    color:#38bdf8;
}

@media(max-width:768px){

.sidebar{
    width:80px;
}

.sidebar h2{
    font-size:1rem;
}

.sidebar ul li{
    text-align:center;
}

.sidebar ul li i{
    margin-right:0;
}

.main{
    margin-left:80px;
    width:calc(100% - 80px);
    padding:20px;
}

}
